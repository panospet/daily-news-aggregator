{{define "base"}}
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Miniflux AI Dashboard</title>
    <meta name="description" content="AI-powered news dashboard with intelligent topic grouping and summaries">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <script defer src="/static/htmx.min.js"></script>
    <script defer>
        document.addEventListener('DOMContentLoaded', function() {
            // Auto-refresh articles every 10min (skip if a card is expanded)
            setInterval(function() {
                if (document.querySelector('.topic-card.expanded')) return;
                htmx.ajax('GET', '/', {target: '#articles', swap: 'innerHTML', indicator: '#loading'});
            }, 600000);
            // Refresh stats every 60s
            setInterval(function() {
                htmx.ajax('GET', '/stats', {target: '#stats-tab', swap: 'outerHTML'});
            }, 60000);

            // ── Keyboard shortcuts ──
            document.addEventListener('keydown', function(e) {
                // "/" focuses the search bar
                if (e.key === '/' && !isEditing(e)) {
                    e.preventDefault();
                    var input = document.querySelector('.search-input');
                    if (input) input.focus();
                }
                // Escape collapses expanded cards or blurs search
                if (e.key === 'Escape') {
                    var expanded = document.querySelectorAll('.topic-card.expanded');
                    if (expanded.length > 0) {
                        expanded.forEach(function(card) {
                            card.classList.remove('expanded');
                        });
                    } else {
                        document.activeElement.blur();
                    }
                }
            });

            function isEditing(e) {
                var tag = e.target.tagName;
                return tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || e.target.isContentEditable;
            }


            // ── Read state management ──
            restoreReadState();

            // ── Stagger card animations ──
            assignCardIndices();
        });

        // ── Read state: localStorage-based tracking ──
        // Key format: "read:<groupID>:<articleCount>"
        // A group is "read" when it has been both expanded AND summarized.

        function getReadGroups() {
            try {
                return JSON.parse(localStorage.getItem('readGroups') || '{}');
            } catch(e) { return {}; }
        }

        function saveReadGroups(obj) {
            localStorage.setItem('readGroups', JSON.stringify(obj));
        }

        function toggleExpand(headerEl) {
            var card = headerEl.closest('.topic-card');
            card.classList.toggle('expanded');

            // If collapsing, no action needed for read state tracking
            if (!card.classList.contains('expanded')) return;

            // Mark as expanded in a transient data attribute
            card.dataset.wasExpanded = 'true';

            // Check if this card was already summarized (HTMX-swapped summary card)
            if (card.dataset.summarized === 'true') {
                markAsRead(card);
            }
        }

        function markAsRead(card) {
            var gid = card.dataset.groupId;
            var cnt = card.dataset.groupCount;
            if (!gid) return;

            var key = gid + ':' + cnt;
            var groups = getReadGroups();
            groups[key] = { groupId: gid, count: cnt, timestamp: Date.now() };
            saveReadGroups(groups);

            card.classList.add('topic-read');
            // Show "mark unread" button
            var unreadBtn = card.querySelector('.mark-unread-btn');
            if (unreadBtn) unreadBtn.style.display = 'inline-flex';
        }

        function markUnread(card) {
            var gid = card.dataset.groupId;
            var cnt = card.dataset.groupCount;
            if (!gid) return;

            var key = gid + ':' + cnt;
            var groups = getReadGroups();
            delete groups[key];
            saveReadGroups(groups);

            card.classList.remove('topic-read');
            // Hide "mark unread" button
            var unreadBtn = card.querySelector('.mark-unread-btn');
            if (unreadBtn) unreadBtn.style.display = 'none';
        }

        function restoreReadState() {
            var groups = getReadGroups();
            document.querySelectorAll('.topic-card[data-group-id]').forEach(function(card) {
                var gid = card.dataset.groupId;
                var cnt = card.dataset.groupCount;
                var key = gid + ':' + cnt;
                if (groups[key]) {
                    card.classList.add('topic-read');
                    var unreadBtn = card.querySelector('.mark-unread-btn');
                    if (unreadBtn) unreadBtn.style.display = 'inline-flex';
                }
            });
        }

        // Clean up old entries (older than 24 hours) to avoid localStorage bloat
        function cleanupReadState() {
            var groups = getReadGroups();
            var cutoff = Date.now() - (24 * 60 * 60 * 1000);
            var changed = false;
            for (var key in groups) {
                if (groups[key].timestamp && groups[key].timestamp < cutoff) {
                    delete groups[key];
                    changed = true;
                }
            }
            if (changed) saveReadGroups(groups);
        }
        cleanupReadState();

        // Sidebar toggle (mobile)
        function toggleSidebar() {
            var sb = document.getElementById('sidebar');
            var ov = document.getElementById('sidebar-overlay');
            sb.classList.toggle('open');
            if (sb.classList.contains('open')) {
                ov.classList.add('visible');
                ov.style.display = 'block';
            } else {
                ov.classList.remove('visible');
                setTimeout(function() { ov.style.display = 'none'; }, 350);
            }
        }

        // Theme toggle with localStorage persistence
        function toggleTheme() {
            var html = document.documentElement;
            var next = html.dataset.theme === 'light' ? 'dark' : 'light';
            html.dataset.theme = next;
            localStorage.setItem('theme', next);
            var btn = document.getElementById('theme-btn-text');
            if (btn) btn.textContent = next === 'light' ? 'Dark mode' : 'Light mode';
            var icon = document.getElementById('theme-btn-icon');
            if (icon) icon.textContent = next === 'light' ? '☀️' : '🌙';
        }

        // Restore saved theme
        (function() {
            var saved = localStorage.getItem('theme');
            if (saved) {
                document.documentElement.dataset.theme = saved;
            }
        })();

        // Category section collapse/expand
        function toggleCategory(el) {
            var section = el.closest('.category-section');
            if (section) section.classList.toggle('collapsed');
        }

        // Filter active state
        document.addEventListener('htmx:afterSwap', function(e) {
            if (e.detail.target && e.detail.target.id === 'articles') {
                // Highlight active nav item
                var trigger = e.detail.requestConfig && e.detail.requestConfig.elt;
                if (trigger && trigger.classList && trigger.classList.contains('nav-item')) {
                    document.querySelectorAll('.nav-item').forEach(function(n) { n.classList.remove('active'); });
                    trigger.classList.add('active');
                }
                // Re-assign stagger indices for newly loaded cards
                assignCardIndices();
                // Restore read state for newly loaded cards
                restoreReadState();
            }
        });

        // Assign stagger animation indices to cards
        function assignCardIndices() {
            document.querySelectorAll('.topic-grid').forEach(function(grid) {
                grid.querySelectorAll('.topic-card').forEach(function(card, i) {
                    card.style.setProperty('--card-index', i);
                });
            });
        }

        // Smooth scroll to expanded card + mark-as-read on summary arrival
        document.addEventListener('htmx:load', function(e) {
            var card = e.detail.elt;
            if (card && card.classList && card.classList.contains('topic-card') && card.classList.contains('expanded')) {
                if (card.dataset.summarized === 'true') {
                    markAsRead(card);
                    setTimeout(function() {
                        card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    }, 100);
                }
            }
        });

        // ── Global Error Handling ──
        document.addEventListener('htmx:responseError', function(e) {
            showToast('Something went wrong. Please try again.', 'error');
        });
        document.addEventListener('htmx:sendError', function(e) {
            showToast('Network error. Please check your connection.', 'error');
        });
        document.addEventListener('htmx:timeout', function(e) {
            showToast('The request took too long. Please try again.', 'error');
        });

        function showToast(message, type) {
            var container = document.getElementById('toast-container');
            if (!container) return;
            var toast = document.createElement('div');
            toast.className = 'toast toast-' + (type || 'info');
            toast.innerHTML = '<span>' + (type === 'error' ? '❌' : 'ℹ️') + '</span> ' + message;
            container.appendChild(toast);
            
            // Trigger animation
            setTimeout(function() { toast.classList.add('show'); }, 10);
            
            // Remove after 3.5s
            setTimeout(function() {
                toast.classList.remove('show');
                setTimeout(function() { toast.remove(); }, 300);
            }, 3500);
        }
    </script>
    <link rel="stylesheet" href="/static/style.css">
</head>
<body hx-headers='{"HX-Request": "true"}'>
    <!-- Toast Notifications Container -->
    <div id="toast-container" class="toast-container"></div>

    <div class="app-layout">
        <div class="bg-mesh-glow"></div>

        <!-- Sidebar Overlay (mobile) -->
        <div id="sidebar-overlay" class="sidebar-overlay" onclick="toggleSidebar()"></div>

        <!-- Sidebar -->
        <aside id="sidebar" class="sidebar">
            <div class="sidebar-header">
                <div class="sidebar-brand">
                    <span class="sidebar-logo">🤖</span>
                    <span class="sidebar-title">Miniflux AI</span>
                </div>
                <div class="sidebar-subtitle">AI-grouped news · {{.Total}} articles</div>
            </div>

            <nav class="sidebar-nav">
                <div class="sidebar-nav-label">Categories</div>
                <ul class="nav-list">
                    <li>
                        <button class="nav-item active"
                                hx-get="/filter?cat=all"
                                hx-target="#articles"
                                hx-push-url="true"
                                hx-indicator="#loading"
                                onclick="if(window.innerWidth<=768)toggleSidebar()">
                            <span class="nav-icon">📋</span>
                            <span class="nav-label">All Articles</span>
                            <span class="nav-count">{{.Total}}</span>
                        </button>
                    </li>
                    {{range .Categories}}
                    <li>
                        <button class="nav-item"
                                hx-get="/filter?cat={{.Category | urlquery}}"
                                hx-target="#articles"
                                hx-push-url="true"
                                hx-indicator="#loading"
                                onclick="if(window.innerWidth<=768)toggleSidebar()">
                            <span class="nav-icon">{{catIcon .Category}}</span>
                            <span class="nav-label">{{.Category}}</span>
                            <span class="nav-count">{{.Count}}</span>
                        </button>
                    </li>
                    {{end}}
                </ul>
            </nav>

            <div class="sidebar-footer">
                <button class="theme-toggle-btn" onclick="toggleTheme()">
                    <span id="theme-btn-icon">🌙</span>
                    <span id="theme-btn-text">Light mode</span>
                </button>
                <div class="sidebar-shortcuts">
                    <span class="kbd-hint"><kbd>/</kbd> Search</span>
                    <span class="kbd-hint"><kbd>Esc</kbd> Close</span>
                </div>
                <div class="sidebar-footer-links">
                    <a href="https://miniflux.app" target="_blank" rel="noopener">Miniflux</a>
                    <a href="https://gemini.google.com" target="_blank" rel="noopener">Gemini AI</a>
                    <a href="https://htmx.org" target="_blank" rel="noopener">HTMX</a>
                    <a href="https://go.dev" target="_blank" rel="noopener">Go</a>
                </div>
            </div>
        </aside>

        <!-- Content Area -->
        <div class="content-area">
            {{ block "page" . }}
            <header class="content-header">
                <div class="content-header-inner">
                    <button class="hamburger-btn" onclick="toggleSidebar()" aria-label="Toggle sidebar">☰</button>
                    <div class="search-wrapper">
                        <span class="search-icon">🔍</span>
                        <input type="search" name="q" class="search-input"
                               placeholder="Search articles..."
                               autocomplete="off"
                               hx-get="/search"
                               hx-trigger="input changed delay:300ms, search"
                               hx-target="#articles"
                               hx-push-url="false">
                    </div>
                    <div class="header-stats" id="stats-tab">
                        <span class="stat-chip">
                            <span class="stat-chip-icon">🤖</span>
                            {{.Total}} articles
                        </span>
                        <span class="stat-chip">
                            <span class="stat-chip-icon">🕐</span>
                            {{.Generated}}
                        </span>
                    </div>
                    <a href="/" class="refresh-btn" title="Homepage" style="text-decoration: none;">🏠</a>
                </div>
            </header>

            <div id="loading" class="htmx-indicator loading-bar">
                <div class="loading-bar-inner"></div>
            </div>

            <main class="main-content">
                {{ template "articles" . }}
            </main>

            <footer class="content-footer">
                <p>Powered by Miniflux · Gemini AI · HTMX · Go</p>
            </footer>
            {{ end }}
        </div>

    </div>
</body>
</html>
{{end}}
