{{define "base"}}
<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f3efe5">
  <meta name="description" content="Your personal, AI-curated daily newsroom. Explore grouped stories, verified summaries, and every original source.">
  <title>Newsroom — Your Daily Edit</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Noto+Serif:ital,wght@0,400;0,500;0,600;0,700;1,500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/style.css">
  <script>
    (function () {
      try { document.documentElement.dataset.theme = localStorage.getItem('flow-theme') || 'light'; } catch (_) {}
    })();
  </script>
  <script src="/static/htmx.min.js" defer></script>
  <script src="/static/app.js" defer></script>
</head>
<body>
  <svg class="icon-library" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></symbol>
    <symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"></path></symbol>
    <symbol id="i-close" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"></path></symbol>
    <symbol id="i-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path></symbol>
    <symbol id="i-moon" viewBox="0 0 24 24"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5 8.5 8.5 0 1 0 20.5 14.2Z"></path></symbol>
    <symbol id="i-chevron" viewBox="0 0 24 24"><path d="m7 10 5 5 5-5"></path></symbol>
    <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 19 19 5M8 5h11v11"></path></symbol>
    <symbol id="i-spark" viewBox="0 0 24 24"><path d="m12 3 1.7 5.3L19 10l-5.3 1.7L12 17l-1.7-5.3L5 10l5.3-1.7L12 3Z"></path><path d="m19 16 .7 2.3L22 19l-2.3.7L19 22l-.7-2.3L16 19l2.3-.7L19 16Z"></path></symbol>
    <symbol id="i-refresh" viewBox="0 0 24 24"><path d="M20 7v5h-5M4 17v-5h5"></path><path d="M6.1 8a7 7 0 0 1 11.6-1L20 12M4 12l2.3 5a7 7 0 0 0 11.6-1"></path></symbol>
    <symbol id="i-thumb" viewBox="0 0 24 24"><path d="M7 10v11H3V10h4ZM7 19c2 1 4 2 7 2h2.2a2 2 0 0 0 2-1.6l1.6-8A2 2 0 0 0 17.8 9H14l1-4a2.5 2.5 0 0 0-4.6-2L7 10"></path></symbol>
    <symbol id="i-mail" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></symbol>
    <symbol id="i-feed" viewBox="0 0 24 24"><path d="M5 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM4 10a10 10 0 0 1 10 10M4 4a16 16 0 0 1 16 16"></path></symbol>
    <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></symbol>
    <symbol id="i-home" viewBox="0 0 24 24"><path d="m3 11 9-8 9 8M5 10v10h14V10M9 20v-6h6v6"></path></symbol>
  </svg>

  <a class="skip-link" href="#stream">Skip to the stories</a>
  <div id="toast-container" class="toast-container" aria-live="polite" aria-atomic="true"></div>
  <div id="loading" role="status"><span class="loading-dot"></span>Updating your edition…</div>
  <div id="backdrop" class="backdrop" aria-hidden="true"></div>

  <header class="masthead">
    <div class="masthead__inner">
      <button class="icon-button menu-btn" type="button" aria-label="Open navigation" aria-controls="panel" aria-expanded="false">
        <svg class="icon"><use href="#i-menu"></use></svg>
      </button>
      <a class="brand" href="/" hx-get="/" hx-target="#stream" hx-swap="outerHTML" hx-push-url="/" aria-label="Newsroom home">
        <span class="brand__mark" aria-hidden="true">N<span>/</span></span>
        <span class="brand__name">Newsroom<span class="brand__tagline">Your personal daily edit</span></span>
      </a>
      <div class="masthead__right">
        <div class="live-label"><span class="live-dot"></span><span>Live briefing</span></div>
        <button class="theme-btn" type="button" data-theme-toggle aria-label="Switch to dark theme" title="Switch color theme">
          <svg class="icon theme-icon theme-icon--sun"><use href="#i-sun"></use></svg>
          <svg class="icon theme-icon theme-icon--moon"><use href="#i-moon"></use></svg>
          <span class="theme-btn__label">Theme</span>
        </button>
      </div>
    </div>
  </header>

  <div class="newsroom-shell">
    <aside id="panel" class="panel" aria-label="News navigation">
      <div class="panel__mobile-head">
        <span class="panel__mobile-title">Your newsroom</span>
        <button class="icon-button panel__close" type="button" aria-label="Close navigation"><svg class="icon"><use href="#i-close"></use></svg></button>
      </div>
      <nav class="panel__scroll">
        <div class="panel__section panel__section--home">
          <a class="nav__item nav__item--overview" data-nav="home" href="/" hx-get="/" hx-target="#stream" hx-swap="outerHTML" hx-push-url="/">
            <svg class="icon nav__icon"><use href="#i-home"></use></svg><span>Top stories</span><span class="nav__arrow">↗</span>
          </a>
        </div>
        <div class="panel__section">
          <h2 class="panel__label"><span>01</span> Topics</h2>
          <ul class="nav">
            {{range .Categories}}<li><a class="nav__item" data-nav="category" href="/filter?cat={{.Category | urlquery}}" hx-get="/filter?cat={{.Category | urlquery}}" hx-target="#stream" hx-swap="outerHTML" hx-push-url="true"><span class="nav__symbol">{{catIcon .Category}}</span><span class="nav__text">{{.Category}}</span><span class="nav__count">{{.Count}}</span></a></li>{{end}}
          </ul>
        </div>
        {{if .TopFeeds}}
        <div class="panel__section">
          <h2 class="panel__label"><span>02</span> Sources</h2>
          <ul class="nav">
            {{range .TopFeeds}}<li><a class="nav__item nav__item--feed" data-nav="feed" href="/search?q=feed:{{.Feed | urlquery}}" hx-get="/search?q=feed:{{.Feed | urlquery}}" hx-target="#stream" hx-swap="outerHTML" hx-push-url="true"><svg class="icon nav__icon"><use href="#i-feed"></use></svg><span class="nav__text">{{.Feed}}</span><span class="nav__count">{{.Count}}</span></a></li>{{end}}
          </ul>
        </div>
        {{end}}
        {{if .TopTags}}
        <div class="panel__section">
          <h2 class="panel__label"><span>03</span> Trending tags</h2>
          <ul class="nav">
            {{range .TopTags}}<li><a class="nav__item nav__item--tag" data-nav="tag" href="/search?q=%23{{.Tag | urlquery}}" hx-get="/search?q=%23{{.Tag | urlquery}}" hx-target="#stream" hx-swap="outerHTML" hx-push-url="true"><span class="nav__hash">#</span><span class="nav__text">{{.Tag}}</span><span class="nav__count">{{.Count}}</span></a></li>{{end}}
          </ul>
        </div>
        {{end}}
      </nav>
      <div class="panel__footer">
        <span class="panel__footer-mark">N/</span>
        <p>Less noise.<br>More perspective.</p>
        <span class="shortcut"><kbd>/</kbd> search <span>·</span> <kbd>esc</kbd> close</span>
      </div>
    </aside>

    <main class="main">
      <section class="intro" aria-labelledby="page-title">
        <div class="intro__copy">
          <div class="intro__eyebrow"><span>The daily edit</span><span class="intro__rule"></span><span>AI curated</span></div>
          <h1 id="page-title">News, <em>distilled.</em></h1>
          <p>One story, every angle. Explore clustered reporting from your feeds, generate grounded summaries, and go straight to the source.</p>
        </div>
        <div class="edition-stamp" aria-label="Edition information">
          <span class="edition-stamp__label">Current edition</span>
          <strong>{{.Total}}</strong>
          <span class="edition-stamp__unit">articles in view</span>
          <span class="edition-stamp__time"><svg class="icon"><use href="#i-clock"></use></svg>{{.Generated}}</span>
          {{if .IsLLMFallback}}<span class="fallback-label">Gemini fallback</span>{{end}}
        </div>
      </section>

      <div class="search-bar">
        <svg class="icon search-bar__icon"><use href="#i-search"></use></svg>
        <label class="sr-only" for="story-search">Search stories, feeds, and tags</label>
        <input id="story-search" class="search" type="search" name="q" placeholder="Search the newsroom…" hx-get="/search" hx-trigger="input changed delay:300ms, search" hx-target="#stream" hx-swap="outerHTML" hx-push-url="true" autocomplete="off">
        <span class="search-bar__hint">Stories, sources, or #tags</span>
        <kbd class="search-bar__key">/</kbd>
      </div>

      {{template "articles" .}}

      <footer class="main-footer"><span>Newsroom · Independent reading, intelligently grouped</span><a href="/" hx-get="/" hx-target="#stream" hx-swap="outerHTML" hx-push-url="/">Back to the front page ↑</a></footer>
    </main>
  </div>
</body>
</html>
{{end}}

{{define "stats-old"}}<div class="meta"><span><b>{{.Total}}</b> articles</span><span>{{.Generated}}</span>{{if .IsLLMFallback}}<span class="fallback-label">Gemini fallback</span>{{end}}</div>{{end}}
