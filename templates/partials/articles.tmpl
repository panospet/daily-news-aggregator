{{define "articles"}}
<div id="stream">
{{if .IsFallback}}<div class="notice-banner">⏳ AI grouping is running in the background. Showing raw articles temporarily.</div>{{end}}
{{range .Categories}}
<section class="cat" id="cat-{{.Category}}">
  <div class="cat__head" onclick="this.parentElement.classList.toggle('cat--closed')">
    <span class="cat__icon">{{catIcon .Category}}</span>
    <span class="cat__name">{{.Category}}</span>
    <span class="cat__count">{{.Count}} {{if eq .Count 1}}story{{else}}stories{{end}}</span>
    <span class="cat__arrow">▾</span>
  </div>
  {{if eq .Count 0}}<div class="empty-cat">No stories in this category.</div>{{else}}
  <div class="cards" id="cards-{{.Category}}">
    {{$cat := .Category}}
    {{range $idx, $group := .Groups}}
    {{if lt $idx 20}}
    {{template "card" $group}}
    {{end}}
    {{end}}
  </div>
  {{if gt .Count 20}}
  <div class="sentinel" hx-get="/cards?cat={{.Category}}&offset=20" hx-trigger="revealed" hx-swap="outerHTML" hx-target="this" hx-indicator="#loading"></div>
  {{end}}
  {{end}}
</section>
{{end}}
{{if eq (len .Categories) 0}}<div class="empty"><div class="empty__icon">◎</div><h2>No matching stories</h2><p>Try a different search or tag.</p></div>{{end}}
</div>
{{end}}

{{define "card"}}
<div class="card" id="topic-{{.GroupID}}" data-group-id="{{.GroupID}}" data-group-count="{{.Count}}">
  <div class="card__head" onclick="toggleCard(this)">
    <span class="card__num">◈</span>
    <span class="card__title">{{.Topic}}</span>
    <span class="card__cnt">{{.Count}}</span>
  </div>
  <div class="card__body">
    <div class="card__tags">{{range .Tags}}<span class="tag">#{{.}}</span>{{end}}{{range uniqueFeeds .Articles}}<span class="tag tag--src">{{.}}</span>{{end}}</div>
    <button class="btn-sum" hx-post="/summarize" hx-vals='{"category":"{{.Category}}","group_id":"{{.GroupID}}"}' hx-target="closest .card" hx-swap="outerHTML" onclick="event.stopPropagation()"><span class="btn-sum__text">✦ Summarize</span><span class="btn-sum__spinner"></span></button>
    <div class="src-label">Sources</div>
    <ul class="src-list">{{range .Articles}}<li><a href="{{.URL}}" target="_blank" rel="noopener"><span>{{.Title}}</span><span>→</span></a><span class="src-meta">{{.Feed}} · {{.TimeAgo}}</span></li>{{end}}</ul>
  </div>
</div>
{{end}}

{{define "cards-sentinel"}}
<div class="sentinel" hx-get="/cards?cat={{.cat}}&offset={{.offset}}" hx-trigger="revealed" hx-swap="outerHTML" hx-target="this" hx-indicator="#loading"></div>
{{end}}

{{define "cards-empty"}}
<div class="empty"><div class="empty__icon">◎</div><h2>No more stories</h2><p>You've reached the end.</p></div>
{{end}}

{{define "summary"}}
<div class="card card--open" id="topic-{{.GroupID}}" data-group-id="{{.GroupID}}" data-group-count="{{len .Articles}}" data-summarized="true">
  <div class="card__head" onclick="toggleCard(this)">
    <span class="card__num">AI</span>
    <span class="card__title">{{.Topic}}</span>
    <span class="card__cnt">{{len .Articles}}</span>
    <button class="btn-unread" style="display:none" onclick="event.stopPropagation(); markUnread(this.closest('.card'))" title="Mark unread">📬 Unread</button>
    <button hx-post="/feedback/positive" hx-vals='{"category":"{{.Category}}","group_id":"{{.GroupID}}"}' hx-swap="outerHTML" class="btn-pos-feedback" title="Good summary" onclick="event.stopPropagation(); this.closest('.card').querySelectorAll('.fb').forEach(b => b.style.display='none');">👍</button>
  </div>
  <div class="card__body">
    <div class="card__tags">{{range .Tags}}<span class="tag">#{{.}}</span>{{end}}</div>
    <div class="summary">{{.Summary}}</div>
    <div class="src-label">Sources</div>
    <ul class="src-list">{{range .Articles}}<li><a href="{{.URL}}" target="_blank" rel="noopener"><span>{{.Title}}</span><span>→</span></a><span class="src-meta">{{.Feed}} · {{.TimeAgo}}</span><button class="fb" hx-post="/feedback" hx-vals='{"category":"{{$.Category}}","group_id":"{{$.GroupID}}","irrelevant_url":"{{.URL}}"}' hx-swap="outerHTML" onclick="event.stopPropagation(); let p = this.closest('.card').querySelector('.btn-pos-feedback'); if(p) p.style.display='none';" title="Not relevant">✕</button></li>{{end}}</ul>
  </div>
</div>
{{end}}

{{define "summary-fallback"}}
<div class="card card--open" id="topic-{{.GroupID}}" data-group-id="{{.GroupID}}" data-group-count="{{len .Articles}}" data-summarized="true">
  <div class="card__head" onclick="toggleCard(this)">
    <span class="card__num">AI</span>
    <span class="card__title">{{.Topic}}</span>
    <span class="card__cnt">{{len .Articles}}</span>
    <button class="btn-unread" style="display:none" onclick="event.stopPropagation(); markUnread(this.closest('.card'))" title="Mark unread">📬 Unread</button>
    <button hx-post="/feedback/positive" hx-vals='{"category":"{{.Category}}","group_id":"{{.GroupID}}"}' hx-swap="outerHTML" class="btn-pos-feedback" title="Good summary" onclick="event.stopPropagation(); this.closest('.card').querySelectorAll('.fb').forEach(b => b.style.display='none');">👍</button>
  </div>
  <div class="card__body">
    <div class="summary"><em>Summary unavailable. Sources below.</em></div>
    <div class="src-label">Sources</div>
    <ul class="src-list">{{range .Articles}}<li><a href="{{.URL}}" target="_blank" rel="noopener"><span>{{.Title}}</span><span>→</span></a><span class="src-meta">{{.Feed}} · {{.TimeAgo}}</span><button class="fb" hx-post="/feedback" hx-vals='{"category":"{{$.Category}}","group_id":"{{$.GroupID}}","irrelevant_url":"{{.URL}}"}' hx-swap="outerHTML" onclick="event.stopPropagation(); let p = this.closest('.card').querySelector('.btn-pos-feedback'); if(p) p.style.display='none';" title="Not relevant">✕</button></li>{{end}}</ul>
  </div>
</div>
{{end}}
