# Miniflux + Cloudflare Access configuration template
# Copy to .miniflux.env and fill in real values (this file is gitignored).

# PostgreSQL (Miniflux database)
POSTGRES_PASSWORD=change-me
ADMIN_PASSWORD=change-me
DATABASE_URL=postgres://miniflux:change-me@db/miniflux?sslmode=disable
PGPASSWORD=change-me

# Cloudflare Access service token (used by cloudflared-client to reach the
# egress proxy over a Cloudflare Access TCP tunnel)
CF_CLIENT_ID=your-client-id.access
CF_CLIENT_SECRET=your-client-secret
# Hostname of the Cloudflare Access TCP application (the remote proxy endpoint)
CF_ACCESS_HOSTNAME=your-access-hostname.example.com

# Miniflux feed-fetch tuning
HTTP_CLIENT_TIMEOUT=75
CLEANUP_ARCHIVE_UNREAD_DAYS=15
CLEANUP_ARCHIVE_READ_DAYS=2
